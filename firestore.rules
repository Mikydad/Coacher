rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Membership = an ACTIVE member doc (pre-launch audit C1, 2026-09-15).
    // Member docs and the circleIds index are server-owned (circle
    // callables); pending / removed docs grant nothing. exists() first so a
    // missing doc is a clean false rather than a get() error.
    function isCircleMember(circleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid))
             .data.status == 'active';
    }

    // Denormalized join index under the user doc — written ONLY by the
    // circle callables (rules deny client writes below), so it is as
    // trustworthy as the member doc and covers the account-switch race.
    function hasCircleIndex(circleId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/circleIds/$(circleId));
    }

    function circleIsPublic(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.visibility == 'public';
    }

    // Chat/activity read: member doc OR circleIds index (covers account-switch races).
    function canAccessCircleContent(circleId) {
      return isCircleMember(circleId) || hasCircleIndex(circleId);
    }

    // Audit H16 — see the user wildcard. `request.resource.data` is the
    // post-merge document for set(merge) writes, so a merge that omits
    // updatedAtMs keeps the stored value and passes.
    function lwwNotStale() {
      return !('updatedAtMs' in resource.data)
        || !(resource.data.updatedAtMs is int)
        || !('updatedAtMs' in request.resource.data)
        || !(request.resource.data.updatedAtMs is int)
        || request.resource.data.updatedAtMs >= resource.data.updatedAtMs;
    }

    // For a map field keyed by uid: the update may add/change/remove only
    // the caller's own entry. Missing maps count as empty.
    function onlyOwnKeyChanged(field) {
      let before = (field in resource.data) ? resource.data[field] : {};
      let after = (field in request.resource.data) ? request.resource.data[field] : {};
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Reads circle doc once to check moderatorIds list
    function isCircleModerator(circleId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/circles/$(circleId)).data.moderatorIds.hasAny([request.auth.uid]);
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    // Users can read/write their own document and subcollections
    // (routines, blocks, tasks, reminders, goals, analytics, etc.) EXCEPT
    // the server-owned trees below (P2-03): overlapping allow statements
    // are OR'd in Firestore rules, so the exclusion must live inside the
    // wildcard's condition — a separate `allow write: if false` match would
    // NOT revoke what the wildcard grants.

    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /{collection}/{document=**} {
        allow read, create, delete: if isUser(uid)
          && !(collection in ['rescueState', 'briefState', 'reminderRescue',
                              'circleIds', 'entitlements']);
        // Audit H16 — last-write-wins enforced server-side: an update may
        // not carry an older `updatedAtMs` than the stored document (the
        // outbox replays offline edits blindly; a stale op from device A
        // must not overwrite device B's newer edit). Ties pass (retries of
        // the same payload); documents without the field are unaffected.
        allow update: if isUser(uid)
          && !(collection in ['rescueState', 'briefState', 'reminderRescue',
                              'circleIds', 'entitlements'])
          && lwwNotStale();
      }

      // Circle membership index (audit C1): written ONLY by the circle
      // callables. A client that could write here could self-grant access
      // to any private circle's chat, feed, and stake material.
      match /circleIds/{circleId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
      // Server-owned entitlements (decision log 2026-07-20 / 2026-09-15 D2):
      // the RevenueCat webhook writes `entitlements/pro`; callables and the
      // client read it. Carved out now so the Pro tier lands on a trusted
      // field — never on the owner-writable user doc.
      match /entitlements/{docId} {
        allow read: if isUser(uid);
        allow write: if false;
      }

      // Rescue-net + morning-brief state (Phase 5): written ONLY by the
      // crons via Admin SDK. A client that could write here could clobber
      // "already rescued today" and re-trigger pushes — or suppress them.
      match /rescueState/{intentionId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
      match /briefState/{docId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
      // Reminder V2 rescue bookkeeping (task 13.0): written ONLY by the
      // reminderSweep cron via Admin SDK. A client that could write here
      // could clobber tailCount and re-open exhausted tails - or suppress
      // a medication rescue by faking one.
      match /reminderRescue/{occurrenceId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // ─── Circles ───────────────────────────────────────────────────────────

    match /circles/{circleId} {

      // Public circles are browsable by every signed-in user (discovery
      // queries filter visibility == public); private circles are visible
      // only to their members (audit C1: private metadata was enumerable).
      allow read: if isSignedIn()
        && (resource.data.visibility == 'public'
            || canAccessCircleContent(circleId));

      // Create / delete / memberCount / creatorId are server-owned
      // (circleCreate, circleDelete, join/leave callables — audit C1/M2).
      allow create, delete: if false;

      // Moderators edit metadata only — never the count or the creator.
      allow update: if isCircleModerator(circleId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['memberCount', 'creatorId']);

      // ── Members ──────────────────────────────────────────────────────────
      // Every write is a circle callable (join, approve, decline, leave,
      // remove). Reads: own doc always (join-state checks), the list for
      // public circles and for members of private ones.
      match /members/{memberId} {
        allow read: if isSignedIn()
          && (circleIsPublic(circleId)
              || canAccessCircleContent(circleId)
              || isUser(memberId));
        allow write: if false;
      }

      // ── Messages ─────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if canAccessCircleContent(circleId);
        allow create: if isCircleMember(circleId)
          && request.resource.data.senderId == request.auth.uid;
        // Sender edits their own message; ANY member may toggle reactions —
        // but only their OWN entry of `reactionsByUser` (uid → [emoji]).
        // Audit L2: the legacy emoji → [uid] map let a member forge or
        // erase others' reactions; it is now read-only (displayed, merged).
        allow update: if isCircleMember(circleId)
          && (
            (resource.data.senderId == request.auth.uid
              && request.resource.data.senderId == resource.data.senderId
              && !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['reactions', 'reactionsByUser']))
            || (request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['reactionsByUser'])
                && onlyOwnKeyChanged('reactionsByUser'))
          );
        allow delete: if isCircleMember(circleId)
          && (resource.data.senderId == request.auth.uid || isCircleModerator(circleId));
      }

      // ── Activity feed ─────────────────────────────────────────────────────
      match /activityFeed/{itemId} {
        allow read: if canAccessCircleContent(circleId);
        // Only members may post, and only as themselves.
        allow create: if isCircleMember(circleId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // ── Weekly commitments ────────────────────────────────────────────────
      // Docs carry userId + weekKey (see WeeklyCommitment.toMap). Only the
      // owner may create/update/delete their commitments (the client's
      // setCommitments/markProgress only ever touch the caller's own docs).
      // Reads stay circle-wide.
      match /weeklyCommitments/{commitmentId} {
        allow read: if canAccessCircleContent(circleId);
        allow create: if isCircleMember(circleId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isCircleMember(circleId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isCircleMember(circleId)
          && resource.data.userId == request.auth.uid;
      }

      // ── Challenges ────────────────────────────────────────────────────────
      match /challenges/{challengeId} {
        allow read: if canAccessCircleContent(circleId);
        allow create: if isCircleMember(circleId)
          && request.resource.data.creatorId == request.auth.uid;
        // Creator/moderator may edit challenge metadata. Regular members may
        // only touch their OWN memberProgress entry (+ the derived
        // teamTotal). `status` is server-written by the vote tally trigger
        // (audit M1: any member could flip it or forge others' progress).
        // creatorId is immutable on every branch.
        allow update: if isCircleMember(circleId)
          && request.resource.data.creatorId == resource.data.creatorId
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['status'])
          && (
            resource.data.creatorId == request.auth.uid
            || isCircleModerator(circleId)
            || (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['memberProgress', 'teamTotal', 'updatedAtMs'])
                && onlyOwnKeyChanged('memberProgress'))
          );
        allow delete: if isCircleModerator(circleId);

        match /votes/{userId} {
          allow read: if isCircleMember(circleId);
          allow write: if isUser(userId) && isCircleMember(circleId);
        }
      }

      // ── AI Pulse ──────────────────────────────────────────────────────────
      // Pulses are generated client-side by ANY member's device
      // (CircleAiPulseService via the ai_pulse_banner) — moderator-only
      // writes silently broke the banner for non-moderators.
      match /aiPulse/{pulseId} {
        allow read: if isCircleMember(circleId);
        allow write: if isCircleMember(circleId);
      }

      // ── Removal votes ─────────────────────────────────────────────────────
      match /removalVotes/{voteId} {
        allow read, write: if isCircleModerator(circleId);
      }
    }

    // ─── Accountability stakes ─────────────────────────────────────────────
    // Server-owned (PRD/Accountability_feature/prd-accountability-stakes.md
    // §7.4): outcomes, statuses, and stake movements are written ONLY by
    // Cloud Functions (Admin SDK bypasses rules). Clients read their
    // challenges and append evidence — nothing else. Treat as
    // security-critical; covered by rules-tests/.

    match /stake_challenges/{challengeId} {
      // Parent doc read: participant or member of the challenge's circle.
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participantUids
        || (resource.data.circleId != ''
            && canAccessCircleContent(resource.data.circleId))
      );
      // All mutations go through callables/sweep.
      allow create, update, delete: if false;

      // Subcollection helpers re-read the parent (resource there is the
      // subdocument, not the challenge).
      function stakeChallenge() {
        return get(/databases/$(database)/documents/stake_challenges/$(challengeId)).data;
      }
      function isStakeParticipant() {
        return isSignedIn()
          && request.auth.uid in stakeChallenge().participantUids;
      }
      function canReadStake() {
        return isStakeParticipant()
          || (stakeChallenge().circleId != ''
              && canAccessCircleContent(stakeChallenge().circleId));
      }

      // CC-3 — append-only audit log; server-written only.
      match /events/{eventId} {
        allow read: if canReadStake();
        allow write: if false;
      }

      // Audit H8 / D1 — evidence is SELF-REPORTED by policy, but bounded:
      // a unit cannot be logged before its day can have arrived (units are
      // action days; one calendar day of grace covers the user's local day
      // boundary), never beyond the goal's unit count, and one row cannot
      // claim more than twice the unit target. Multi-party outcomes also
      // pass dispute + vote. Challenges created before startDateMs existed
      // skip the window check.
      function evidenceUnitWindowOk() {
        let goal = stakeChallenge().frozenGoal;
        let unitIndex = request.resource.data.unitIndex;
        return unitIndex < goal.totalUnits
          && (!('startDateMs' in goal)
              || unitIndex * 86400000
                   <= request.time.toMillis() - goal.startDateMs + 86400000);
      }
      function evidenceAmountOk() {
        let goal = stakeChallenge().frozenGoal;
        return request.resource.data.amount <= goal.unitTarget * 2
          && request.resource.data.recordedAtMs
               <= request.time.toMillis() + 300000;
      }

      // M-5/CC-5 — the ONE client-writable path: a participant appends own
      // evidence. Immutable once created; arrivedAtMs is server-stamped by
      // the stakeEvidenceArrived trigger and may never come from a client.
      match /evidence/{evidenceId} {
        allow read: if canReadStake();
        allow create: if isStakeParticipant()
          && evidenceId.matches(request.auth.uid + '_.*')
          && stakeChallenge().status in ['active', 'pending_verification']
          && request.resource.data.keys().hasOnly(
               ['id', 'challengeId', 'uid', 'unitIndex', 'amount',
                'source', 'recordedAtMs', 'updatedAtMs'])
          && request.resource.data.keys().hasAll(
               ['uid', 'unitIndex', 'amount', 'source', 'recordedAtMs',
                'updatedAtMs'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.unitIndex is int
          && request.resource.data.unitIndex >= 0
          && request.resource.data.unitIndex < 90
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000
          && request.resource.data.source in ['timer', 'camera', 'checkin']
          && request.resource.data.recordedAtMs is int
          && request.resource.data.updatedAtMs is int
          && evidenceUnitWindowOk()
          && evidenceAmountOk();
        allow update, delete: if false;
      }

      // V-2/V-3/M-6 — written only via callables (validation lives there).
      match /confirmations/{confirmationId} {
        allow read: if canReadStake();
        allow write: if false;
      }
      match /votes/{voteId} {
        allow read: if canReadStake();
        allow write: if false;
      }
      match /vetoRequests/{requestUid} {
        allow read: if isStakeParticipant();
        allow write: if false;
      }
    }

    // P-7/M-6 — strikes, bans, veto timestamps. Server-written only.
    match /enforcement/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // PT-1/PT-2 — the points ledger. Balance is truth-derived from the
    // append-only txns; EVERY write comes from Cloud Functions. A client
    // that could write here could print money — keep this write-denied
    // forever.
    match /points_ledger/{uid} {
      allow read: if isUser(uid);
      allow write: if false;

      match /txns/{txnId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // D7 — curated charity list, admin-managed (Admin SDK only). Clients
    // read only ACTIVE entries; nobody free-enters a recipient, ever.
    match /charities/{charityId} {
      allow read: if isSignedIn() && resource.data.active == true;
      allow write: if false;
    }

    // $-1/$-2 — money escrow records. Owner reads their own; every write
    // is server-side (charge, refund queue, admin disbursement). A client
    // that could touch these could move money — write-denied forever.
    match /stake_escrows/{escrowId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── Tester allowlist (audit M11 / D5) ─────────────────────────────────
    // `tester_allowlist/{uid}` exists ⇔ that account may enable tester mode.
    // Written only from the console (Admin); the owner may read their own.
    match /tester_allowlist/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // ─── Feedback ──────────────────────────────────────────────────────────
    // In-app bug reports / feature requests / questions. Create-only from
    // clients; reports are reviewed in the Firebase console (no client read).
    // The hasOnly key list MUST mirror FeedbackReport.toMap() — a unit test
    // (feedback_report_model_test.dart "toMap key set…") guards the pair.

    // ─── Waitlist (public website) ─────────────────────────────────────────
    // Pre-launch signups from sidepal.io (SidePal_web repo, lib/waitlist.ts
    // writes via REST). UNAUTHENTICATED create-only with a strict shape;
    // reviewed in the console. No read/update/delete from any client — the
    // email list must never be scrapeable.

    match /waitlist/{signupId} {
      allow create: if request.resource.data.keys().hasOnly(
             ['email', 'source', 'createdAtMs'])
        && request.resource.data.keys().hasAll(
             ['email', 'source', 'createdAtMs'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.source == 'website'
        && request.resource.data.createdAtMs is int;
      allow read, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['userId', 'type', 'message', 'context', 'screenshotUrl',
              'status', 'createdAtMs', 'schemaVersion'])
        && request.resource.data.keys().hasAll(
             ['userId', 'type', 'message', 'context', 'status',
              'createdAtMs', 'schemaVersion'])
        && request.resource.data.type in ['bug', 'feature', 'question', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.context is map
        && request.resource.data.status == 'new'
        && request.resource.data.createdAtMs is int
        && request.resource.data.schemaVersion is int
        && (!('screenshotUrl' in request.resource.data)
            || request.resource.data.screenshotUrl is string);
      allow read, update, delete: if false;
    }
  }
}
